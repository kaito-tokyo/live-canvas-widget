Checks: >
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  modernize-*,
  portability-*,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once

WarningsAsErrors: ""
HeaderFilterRegex: ".*"
FormatStyle: file
